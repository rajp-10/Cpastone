# Smart AI Travel Planner — Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini AI API Key (FREE tier available)
# Get from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (FREE tier: 1000 calls/day)
# Get from: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweathermap_key_here

# Unsplash API Key (optional — for dynamic images)
# Get from: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_key_here
